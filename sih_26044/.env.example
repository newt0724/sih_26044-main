# Server & Auth Configuration
SECRET_KEY=super-secret-academia-industry-platform-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite by default, swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/academia_industry_db

# File Storage & ML Paths
UPLOAD_DIR=./uploads
MODEL_DIR=./ml/models

# External Integrations
GITHUB_TOKEN=your_github_personal_access_token_here

# Frontend CORS
FRONTEND_URL=http://localhost:3000